rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection Healthcheck
    match /test/{docId} {
      allow read: if true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User Profile
    match /users/{userId} {
      allow read, write: if isValidId(userId);

      // User Meals Subcollection
      match /meals/{mealId} {
        allow read, write: if isValidId(userId);
      }

      // User Daily Logs (Hydration, etc.)
      match /dailyLogs/{date} {
        allow read, write: if isValidId(userId);
      }
    }
  }
}
